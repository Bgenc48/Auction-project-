{
  "manifest_version": 3,
  "name": "RL Spear Bid Assistant",
  "version": "0.3.0",
  "description": "Track lots on bid.rlspear.com: see wins/outbids, rank lots by real discount off retail, and pre-fill the site's Max Bid box on request. Read-only — you place every bid.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "*://bid.rlspear.com/*",
    "*://*.rlspear.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "RL Spear Bid Assistant",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["*://bid.rlspear.com/*", "*://*.rlspear.com/*"],
      "js": ["src/selectors.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
